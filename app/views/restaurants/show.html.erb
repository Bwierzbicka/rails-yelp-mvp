
<%= render @restaurant %>
<%# <%= link_to "Add review", new_restaurant_review_path(@restaurant), class: "my-3 btn btn-secondary" %>

<h3 class="mt-5">Write a review</h3>
<%= simple_form_for [@restaurant, @review] do |f| %>
    <%= f.input :rating, :collection => [ 0, 1, 2, 3, 4, 5 ] %>
    <%= f.input :content %>
    <%= f.submit "Submit review", class: "btn btn-primary" %>
<% end %>

<h3 class="mt-5">Reviews</h3>
<% @restaurant.reviews.each do |review| %>
<div class="card p-4 pb-1 my-3">
  <p>
    <% if review.rating == 0 %>
      <% 5.times do %> <i class="fa-regular fa-star"></i> <%end %>
    <% elsif review.rating == 1 %>
      <i class="fa-solid fa-star"></i>
      <% 4.times do %> <i class="fa-regular fa-star"></i> <%end %>
    <% elsif review.rating == 2 %>
      <% 2.times do %> <i class="fa-solid fa-star"></i> <%end %>
      <% 3.times do %> <i class="fa-regular fa-star"></i> <%end %>
    <% elsif review.rating == 3 %>
      <% 3.times do %> <i class="fa-solid fa-star"></i><% end %>
      <% 2.times do %> <i class="fa-regular fa-star"></i><% end %>
    <% elsif review.rating == 4 %>
      <% 4.times do %> <i class="fa-solid fa-star"></i> <%end %>
      <i class="fa-regular fa-star"></i>
    <% elsif review.rating == 5 %>
      <% 5.times do %> <i class="fa-solid fa-star"></i> <%end %>
    <%end %>
  </p>
  <p><%= review.content %></p>
</div>
<% end %>
